# AWS Cloud Configuration Template
# Copy this file to .env and fill in your values
# DO NOT commit .env file with actual values to version control

# AWS Region Configuration
AWS_REGION=us-east-1

# S3 Storage Configuration
S3_BUCKET_NAME=my-app-bucket
USE_S3_STORAGE=true
README_FILE_PATH=README.md
UPLOAD_FILE_S3_KEY=files-to-upload.txt

# HTTP Client Configuration
HTTP_REQUEST_TIMEOUT_SECONDS=30
UPLOAD_ENDPOINT_URL=http://localhost:8080/upload/
DOWNLOAD_URL=https://labs.consol.de/
AUTH_TARGET_URL=https://labs.consol.de
PROXY_TARGET_URL=https://www.google.com

# Proxy Configuration
PROXY_HOST=127.0.0.1
PROXY_PORT=1080

# AWS Secrets Manager Configuration
# Store credentials in AWS Secrets Manager with this secret name
# Expected format: {"username":"your-username","password":"your-password"}
AUTH_SECRET_NAME=app/basic-auth

# Logging Configuration
# Configure in logback.xml or log4j2.xml for structured JSON logging to CloudWatch
